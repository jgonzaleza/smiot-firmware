--- /tmp/lilygo-tgz/lib/TinyGSM/src/TinyGsmClientA7608.h	2026-11-01 19:50:12
+++ lib/TinyGSM/src/TinyGsmClientA7608.h	2026-11-02 10:58:31
@@ -113,6 +113,23 @@
     memset(sockets, 0, sizeof(sockets));
   }
 
+  // Local edit: 0.11.7 exposed these names. 1.0.0 folded them into
+  // setNetworkActive(), which closes the PDP before every open. Keep the
+  // open-only and close-only calls the firmware already uses.
+  bool enableNetwork() {
+    sendAT(GF("+NETOPEN"));
+    int res = waitResponse(GF("+NETOPEN: 0"),
+                           GF("+IP ERROR: Network is already opened"));
+    return res == 1 || res == 2;
+  }
+
+  bool disableNetwork() {
+    sendAT(GF("+NETCLOSE"));
+    if (waitResponse() != 1) { return false; }
+    int res = waitResponse(GF("+NETCLOSE: 0"), GF("+NETCLOSE: 2"));
+    return res == 1 || res == 2;
+  }
+
   /*
    * Basic functions
